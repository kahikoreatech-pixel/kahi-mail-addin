<?xml version="1.0" encoding="UTF-8"?>
<!-- KAHI 메일 도우미 — Outlook 추가 기능(읽기 전용).
     __BASE__ 는 배포 주소(예: https://계정.github.io/kahi-mail-addin)로 자동 치환된다. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>7c1f3c52-4b8e-4f6a-9a51-2d0f6b3e9a17</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>KAHI</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="KAHI 메일 도우미"/>
  <Description DefaultValue="크리에이터 메일의 국문 번역·요약·할 일을 메일 옆에 보여 줍니다. 메일을 읽기만 하고 수정·발송하지 않습니다."/>
  <IconUrl DefaultValue="__BASE__/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="__BASE__/assets/icon-128.png"/>
  <SupportUrl DefaultValue="__BASE__/help.html"/>
  <AppDomains>
    <AppDomain>https://script.google.com</AppDomain>
    <AppDomain>https://script.googleusercontent.com</AppDomain>
    <AppDomain>https://claude.ai</AppDomain>
    <AppDomain>https://docs.google.com</AppDomain>
    <AppDomain>https://drive.google.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="__BASE__/taskpane.html"/>
        <RequestedHeight>300</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="kahiGroup10">
                <Label resid="groupLabel"/>
                <Control xsi:type="Button" id="kahiOpenPane10">
                  <Label resid="btnLabel"/>
                  <Supertip>
                    <Title resid="btnLabel"/>
                    <Description resid="btnDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16"/>
                    <bt:Image size="32" resid="icon32"/>
                    <bt:Image size="80" resid="icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="__BASE__/assets/icon-16.png"/>
        <bt:Image id="icon32" DefaultValue="__BASE__/assets/icon-32.png"/>
        <bt:Image id="icon80" DefaultValue="__BASE__/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="__BASE__/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="KAHI"/>
        <bt:String id="btnLabel" DefaultValue="KAHI 번역·요약"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="btnDesc" DefaultValue="이 메일의 국문 번역·요약·할 일을 오른쪽 창에 보여 줍니다."/>
      </bt:LongStrings>
    </Resources>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <SupportsSharedFolders>true</SupportsSharedFolders>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="kahiGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="kahiOpenPane">
                    <Label resid="btnLabel"/>
                    <Supertip>
                      <Title resid="btnLabel"/>
                      <Description resid="btnDesc"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="__BASE__/assets/icon-16.png"/>
          <bt:Image id="icon32" DefaultValue="__BASE__/assets/icon-32.png"/>
          <bt:Image id="icon80" DefaultValue="__BASE__/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="taskpaneUrl" DefaultValue="__BASE__/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="KAHI"/>
          <bt:String id="btnLabel" DefaultValue="KAHI 번역·요약"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="btnDesc" DefaultValue="이 메일의 국문 번역·요약·할 일을 오른쪽 창에 보여 줍니다. 창을 고정하면 메일을 옮겨 다녀도 계속 보입니다."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
